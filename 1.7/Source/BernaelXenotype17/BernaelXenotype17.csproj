<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>BernaelXenotype</AssemblyName>
    <RootNamespace>Bernael_Xenotype</RootNamespace>
    <Authors>Font</Authors>
    <NuGetAudit>false</NuGetAudit>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <OutputPath>..\..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- DarkMirage\Unity holds editor scripts that only Unity can compile; list sources explicitly. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Bernael\**\*.cs" />
    <Compile Include="DarkMirage\DarkMirage.cs" />
    <Compile Include="DarkMirage\MirageVisuals.cs" />
    <Compile Include="DarkMirage\DebugActions.cs" />
    <Compile Include="DarkMirage\Unity\Assets\Shared\MirageDistanceField.cs" />
  </ItemGroup>

  <!-- Reference assemblies from NuGet, so the build needs no local RimWorld install (CI, any Steam library). -->
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4995-unstable" />
    <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.4" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
</Project>
