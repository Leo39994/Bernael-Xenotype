<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<GeneDef ParentName="GeneJawBase">
		<defName>BX_DepravedHead</defName>
		<label>Depraved Head</label>
		<labelShortAdj>wide-mouthed</labelShortAdj>
		<description>Carriers of this gene develop unnaturally hollow facial contours, sunken. Their unsettling visage seems to radiate desperation and depravity. </description>
		<iconPath>UI/Icons/Genes/BX_DepravedHead</iconPath>
		<displayOrderInCategory>0</displayOrderInCategory>
		<displayCategory>Cosmetic</displayCategory>
		<biostatCpx>0</biostatCpx>
		<forcedHeadTypes>
			<li>BX_Depraved</li>
		</forcedHeadTypes>
	</GeneDef>

	<GeneDef>
		<defName>BX_EtherealSight</defName>
		<label>Ethereal Sight</label>
		<labelShortAdj>ethereal-sighted</labelShortAdj>
		<description>A gene that enhances the carrier's pineal gland for psychic perception, rendering conventional eyesight obsolete.</description>
		<geneClass>Bernael_Xenotype.Gene_BernaelBlind</geneClass>
		<iconPath>UI/Icons/Genes/BX_EtherealSight</iconPath>
		<displayOrderInCategory>1</displayOrderInCategory>
		<displayCategory>BX_DarkEnergy</displayCategory>
		<selectionWeight>0</selectionWeight>
		<biostatCpx>1</biostatCpx>
		<biostatMet>-1</biostatMet>
		<prerequisite>BX_SoulEater</prerequisite>
		<modExtensions>
			<li MayRequire="OskarPotocki.VanillaFactionsExpanded.Core" Class="VEF.Genes.GeneExtension">
				<backgroundPathXenogenes>UI/Icons/Genes/BX_XenogenesSoul</backgroundPathXenogenes>
				<backgroundPathEndogenes>UI/Icons/Genes/BX_XenogenesSoul</backgroundPathEndogenes>
				<backgroundPathArchite>UI/Icons/Genes/BX_XenogenesSoul</backgroundPathArchite>
			</li>
		</modExtensions>
	</GeneDef>
	
	<GeneDef>
		<defName>BX_CravedBody</defName>
		<label>Craved Body</label>
		<labelShortAdj>craved</labelShortAdj>
		<description>Carriers of this gene have a Craved-shaped bodies. A person can have more than one body type gene; one body type will be chosen among those that are allowed. This form is an uncomfortable sight to see, it's anorexic, sickly, it's a body that says desperation in every inch.</description>
		<biostatCpx>0</biostatCpx>
		<selectionWeight>0</selectionWeight>
		<displayOrderInCategory>437</displayOrderInCategory>
		<iconPath>UI/Icons/Genes/BX_CravedBody</iconPath>
		<exclusionTags>
			<li>Bodies</li>
			<li>Body</li>
		</exclusionTags>
		<displayCategory>Miscellaneous</displayCategory>
		<fur>BX_Craved</fur>
		<skinIsHairColor>false</skinIsHairColor>
		<tattoosVisible>false</tattoosVisible>
		<renderNodeProperties>
			<li>
				<nodeClass>PawnRenderNode_Fur</nodeClass>
				<workerClass>PawnRenderNodeWorker_Fur</workerClass>
				<baseLayer>5</baseLayer>
				<rotDrawMode>Fresh, Rotting</rotDrawMode>
				<colorType>Skin</colorType>
				<parentTagDef>Body</parentTagDef>
			</li>
		</renderNodeProperties>
		<modExtensions>
			<li MayRequire="OskarPotocki.VanillaFactionsExpanded.Core" Class="VEF.Genes.GeneExtension">
				<useSkinColorForFur>true</useSkinColorForFur>
				<furHidesBody>true</furHidesBody>
			</li>
		</modExtensions>
	</GeneDef>
	
	<GeneDef Name="HaloBase">
		<defName>BX_Profane_Halo</defName>
		<label>Top halo</label>
		<description>Carriers of this gene manifest a jagged halo of dark, crimson radiance above their heads, an outward manifestation of their twisted psychic presence. Its sinister glow perverts the symbolism of the angelic aureole, turning a sign of holiness into an unsettling emblem of profaned transcendence. </description>
		<iconPath>UI/Icons/Genes/BX_ProfaneHalo</iconPath>
		<displayOrderInCategory>14</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>-1</biostatMet>
		<renderNodeProperties>
			<li>
				<nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
				<workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
				<texPaths>
					<li>Parts/Halo/ProfaneHalo_A</li>
					<li>Parts/Halo/ProfaneHalo_B</li>
					<li>Parts/Halo/ProfaneHalo_C</li>
					<li>Parts/Halo/ProfaneHalo_D</li>
				</texPaths>
				<drawSize>1.0</drawSize>
				<parentTagDef>Head</parentTagDef>
				<shaderTypeDef>TransparentPostLight</shaderTypeDef>
				<color>(255, 255, 255, 200)</color>
				<colorType>Custom</colorType>
				<rotDrawMode>Fresh</rotDrawMode>
				<drawData>
					<defaultData>
						<layer>81</layer>
						<offset>(0, -0.5, 0)</offset>
					</defaultData>
					<dataNorth>
						<layer>10</layer>
						<offset>(0, 0.3, 0.2)</offset>
					</dataNorth>
					<dataEast>
						<offset>(0, 0.1, 0.2)</offset>
					</dataEast>
					<dataSouth>
						<offset>(0, 0.1, 0.2)</offset>
					</dataSouth>
				</drawData>
			</li>
		</renderNodeProperties>
		<modExtensions>
			<li MayRequire="OskarPotocki.VanillaFactionsExpanded.Core" Class="VEF.Genes.GeneExtension">
				<backgroundPathXenogenes>UI/Icons/Genes</backgroundPathXenogenes>
			</li>
		</modExtensions>
	</GeneDef>
	
	<GeneDef Name="WingsBase">
		<defName>BX_CurvedWings</defName>
		<label>Curved Wings</label>
		<description>Carriers of this gene develop a pair of curved, partially atrophied black wings incapable of true flight. Their muscles can unleash a sudden evasive burst, propelling the carrier a short distance while scattering accumulated powdery residue into a dense, dark cloud that blinds enemies, obscures their movements, and extinguishes fires.</description>
		<iconPath>UI/Icons/Genes/BX_CurvedWings</iconPath>
		<abilities>
			<li>BX_WingBurst</li>
		</abilities>
		<descriptionHyperlinks>
			<AbilityDef>BX_WingBurst</AbilityDef>
		</descriptionHyperlinks>
		<displayOrderInCategory>25</displayOrderInCategory>
		<biostatMet>-3</biostatMet>
		<biostatCpx>1</biostatCpx>
		<renderNodeProperties>
			<li>
				<workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
				<texPath>Parts/Wings/CurvedWings</texPath>
				<drawSize>1.20</drawSize>
				<parentTagDef>Body</parentTagDef>
				<rotDrawMode>Fresh</rotDrawMode>
				<drawData>
					<defaultData>
						<layer>-1</layer>
					</defaultData>
					<scaleOffsetByBodySize>true</scaleOffsetByBodySize>
					<dataNorth>
						<layer>90</layer>
						<offset>(0, 0.3, -0.18)</offset>
					</dataNorth>
					<dataSouth>
						<offset>(0, -0.2, -0.05)</offset>
					</dataSouth>
					<dataEast>
						<offset>(-0.13, 0.0, -0.1)</offset>
					</dataEast>
				</drawData>
			</li>
		</renderNodeProperties>
	</GeneDef>
	
	<GeneDef ParentName="GeneSkinColorOverride">
		<defName>BX_Skin_Withered</defName>
		<label>Withered skin</label>
		<labelShortAdj>withered</labelShortAdj>
		<description>Carriers of this gene have a Withered skin.</description>
		<skinColorOverride>(63, 55, 55)</skinColorOverride>
		<randomBrightnessFactor>0</randomBrightnessFactor>
		<displayOrderInCategory>94</displayOrderInCategory>
		<modExtensions>
			<li MayRequire="OskarPotocki.VanillaFactionsExpanded.Core" Class="VEF.Genes.GeneExtension">
				<backgroundPathXenogenes>UI/BlankNP</backgroundPathXenogenes>
			</li>
		</modExtensions>
	</GeneDef>
	
	<GeneDef>
		<defName>BX_WitheredSoul</defName>
		<label>Withered Soul</label>
		<labelShortAdj>withered</labelShortAdj>
		<description>Carriers of this gene experience worsening pain as their mood falls, but pain itself does not reduce their mood.</description>
		<biostatCpx>1</biostatCpx>
		<biostatMet>3</biostatMet>
		<displayOrderInCategory>438</displayOrderInCategory>
		<iconPath>UI/Icons/Genes/BX_WitheredSoul</iconPath>
		<geneClass>Bernael_Xenotype.Gene_Hediff</geneClass>
		<modExtensions>
			<li Class="Bernael_Xenotype.GeneAddHediffExtension">
				<hediffsToAdd>
					<li>BX_WitheredSoulHediff</li>
				</hediffsToAdd>
			</li>
		</modExtensions>
	</GeneDef>
	
	<GeneDef>
		<defName>BX_Warlockracy</defName>
		<label>warlockracy</label>
		<labelShortAdj>warlockracy</labelShortAdj>
		<description>The carrier perceives the psychic aura of others, developing intense affinity for those with powerful psychic sensitivity and profound contempt for those with weak or absent psychic sensitivity, regardless of their social standing or usefulness.</description>
		<biostatCpx>1</biostatCpx>
		<biostatMet>3</biostatMet>
		<displayOrderInCategory>439</displayOrderInCategory>
		<iconPath>UI/Icons/Genes/BX_Warlockracy</iconPath>
		<symbolPack>
			<prefixSymbols>
				<li><symbol>psi</symbol></li>
				<li><symbol>mage</symbol></li>
			</prefixSymbols>
		</symbolPack>
	</GeneDef>
	
	<GeneDef>
		<defName>BX_DarkSpeech</defName>
		<label>Dark Speech</label>
		<description>This gene twists the carrier's speech into something deeply unsettling. Their words grate on the ears and leave a knot in the stomach, making every conversation memorable for the wrong reasons. Listeners find themselves irritated and uneasy, making negotiation difficult.</description>
		<geneClass>Gene</geneClass>
		<biostatCpx>1</biostatCpx>
		<biostatMet>1</biostatMet>
		<displayCategory>BX_DarkEnergy</displayCategory>
		<displayOrderInCategory>63</displayOrderInCategory>
		<iconPath>UI/Icons/Genes/BX_DarkSpeech</iconPath>
	</GeneDef>

<!-- Moved withered soul hediff to the hediff file -->
	
	<GeneDef>
		<defName>BX_Nihilism</defName>
		<label>Nihilism</label>
		<description>This gene makes its carriers exceptionally resistant to recruitment and ideological conversion. Their convictions are difficult to sway, and attempts to change their allegiance or beliefs are rarely successful.</description>
		<geneClass>Bernael_Xenotype.Gene_Nihilism</geneClass>
		<biostatCpx>1</biostatCpx>
		<biostatMet>2</biostatMet>
		<displayOrderInCategory>438</displayOrderInCategory>
		<iconPath>UI/Icons/Genes/BX_Nihilism</iconPath>
		<statFactors>
			<CertaintyLossFactor MayRequire="Ludeon.Rimworld.Ideology">0.5</CertaintyLossFactor>
		</statFactors>
	</GeneDef>
	
	<!-- ====Soul==== -->
	
	<GeneDef>
		<defName>BX_ReaperEcstasy</defName>
		<label>Reaper’s Ecstasy</label>
		<description>Every living creature killed by the carrier restores 10% Soul Saturation. Hostile kills also improve psycaster abilities by reducing neural heat and increasing psychic sensitivity. Each hostile kill refreshes the shared decay timer; after one in-game hour without another hostile kill, the effect loses one level per hour. This allows the player to sustain their Bernael through active combat and hunting rather than just imprisonment.</description>
		<geneClass>Bernael_Xenotype.Gene_Hediff</geneClass>
		<biostatCpx>1</biostatCpx>
		<biostatMet>3</biostatMet>
				<displayCategory>BX_DarkEnergy</displayCategory>
		<displayOrderInCategory>60</displayOrderInCategory>
		<iconPath>UI/Icons/Genes/BX_ReapersEcstasy</iconPath>
		<modExtensions>
			<li Class="Bernael_Xenotype.GeneAddHediffExtension">
				<hediffsToAdd>
					<li>BX_ReaperEcstasy</li>
				</hediffsToAdd>
			</li>
			<li MayRequire="OskarPotocki.VanillaFactionsExpanded.Core" Class="VEF.Genes.GeneExtension">
				<backgroundPathXenogenes>UI/Icons/Genes/BX_XenogenesSoul</backgroundPathXenogenes>
				<backgroundPathEndogenes>UI/Icons/Genes/BX_XenogenesSoul</backgroundPathEndogenes>
				<backgroundPathArchite>UI/Icons/Genes/BX_XenogenesSoul</backgroundPathArchite>
			</li>
		</modExtensions>
	</GeneDef>
	
	<GeneDef MayRequire="Sov.Nephilim">
		<defName>BX_Grace_Galling</defName>
		<label>Grace Galling</label>
		<description>This gene causes its carriers to develop an intense aversion to individuals who have used Grace. The mere presence of a Grace user provokes deep hostility, overriding personal loyalties and social bonds.</description>
		<geneClass>Gene</geneClass>
		<biostatCpx>1</biostatCpx>
		<biostatMet>1</biostatMet>
				<displayCategory>BX_DarkEnergy</displayCategory>
		<displayOrderInCategory>61</displayOrderInCategory>
		<iconPath>UI/Icons/Genes/BX_GraceGalling</iconPath>
		<prerequisite>BX_SoulEater</prerequisite>
		<modExtensions>
			<li MayRequire="OskarPotocki.VanillaFactionsExpanded.Core" Class="VEF.Genes.GeneExtension">
				<backgroundPathXenogenes>UI/Icons/Genes/BX_XenogenesSoul</backgroundPathXenogenes>
				<backgroundPathEndogenes>UI/Icons/Genes/BX_XenogenesSoul</backgroundPathEndogenes>
				<backgroundPathArchite>UI/Icons/Genes/BX_XenogenesSoul</backgroundPathArchite>
			</li>
		</modExtensions>
	</GeneDef>
	
	<GeneDef MayRequire="Sov.Nephilim">
		<defName>BX_SoulPendulum</defName>
		<label>Pendulum of Soul</label>
		<description>Carriers of this gene that transforms an angel into a fallen one (and vice versa) when they are deprived of Grace and suffering from a mental break.</description>
		<geneClass>Bernael_Xenotype.Gene_Pendulum</geneClass>
		<biostatCpx>1</biostatCpx>
		<biostatMet>-1</biostatMet>
				<displayCategory>BX_DarkEnergy</displayCategory>
		<displayOrderInCategory>62</displayOrderInCategory>
		<iconPath>UI/Icons/Genes/BX_PendulumOfSoul</iconPath>
		<prerequisite>BX_SoulEater</prerequisite>
		<modExtensions>
			<li MayRequire="OskarPotocki.VanillaFactionsExpanded.Core" Class="VEF.Genes.GeneExtension">
				<backgroundPathXenogenes>UI/Icons/Genes/BX_XenogenesSoul</backgroundPathXenogenes>
				<backgroundPathEndogenes>UI/Icons/Genes/BX_XenogenesSoul</backgroundPathEndogenes>
				<backgroundPathArchite>UI/Icons/Genes/BX_XenogenesSoul</backgroundPathArchite>
			</li>
		</modExtensions>
		<mentalBreakMtbDays>0.1</mentalBreakMtbDays>
		<mentalBreakDef>BX_SoulFeedingFrenzy</mentalBreakDef>
	</GeneDef>
	
	<GeneDef MayRequire="Sov.Nephilim">
		<defName>BX_GracePendulum</defName>
		<label>Pendulum of Grace</label>
		<description>Carriers of this gene that transforms an angel into a fallen one (and vice versa) when they are deprived of Grace and suffering from a mental break.</description>
		<geneClass>Bernael_Xenotype.Gene_Pendulum</geneClass>
		<biostatCpx>1</biostatCpx>
		<biostatMet>-1</biostatMet>
				<displayCategory>BX_DarkEnergy</displayCategory>
		<displayOrderInCategory>62</displayOrderInCategory>
		<iconPath>UI/Icons/Genes/BX_PendulumOfGrace</iconPath>
		<prerequisite>BX_SoulEater</prerequisite>
		<modExtensions>
			<li MayRequire="OskarPotocki.VanillaFactionsExpanded.Core" Class="VEF.Genes.GeneExtension">
				<backgroundPathXenogenes>UI/Icons/Genes/BX_XenogenesSoul</backgroundPathXenogenes>
				<backgroundPathEndogenes>UI/Icons/Genes/BX_XenogenesSoul</backgroundPathEndogenes>
				<backgroundPathArchite>UI/Icons/Genes/BX_XenogenesSoul</backgroundPathArchite>
			</li>
		</modExtensions>
		<mentalBreakMtbDays>0.1</mentalBreakMtbDays>
		<mentalBreakDef>BX_SoulFeedingFrenzy</mentalBreakDef>
	</GeneDef>


		<!-- ====Archo==== -->


	<GeneDef>
		<defName>BX_EssenceReservoir</defName>
		<label>Essence Reservoir</label>
		<description>Carriers of this gene possess a volatile spiritual reservoir within their desiccated bodies capable of violently purging stored soul essence. When activated, the organism ruptures its internal vessel, converting trapped souls into an agonizing burst of homing projectiles. Grants the Rancor of Souls ability.</description>
		<geneClass>Gene</geneClass>
		<biostatCpx>5</biostatCpx>
		<biostatMet>0</biostatMet>
		<biostatArc>1</biostatArc>
		<displayCategory>BX_DarkEnergy</displayCategory>
		<displayOrderInCategory>-98</displayOrderInCategory>
		<iconPath>UI/Icons/Genes/BX_EssenceReservoir</iconPath>
		<selectionWeight>0</selectionWeight>
		<prerequisite>BX_SoulEater</prerequisite>
		<abilities>
			<li>BX_RancorOfSouls</li>
		</abilities>
		<descriptionHyperlinks>
			<AbilityDef>BX_RancorOfSouls</AbilityDef>
		</descriptionHyperlinks>
		<modExtensions>
			<li MayRequire="OskarPotocki.VanillaFactionsExpanded.Core" Class="VEF.Genes.GeneExtension">
				<backgroundPathXenogenes>UI/Icons/Genes/BX_ArchogenesDark</backgroundPathXenogenes>
				<backgroundPathEndogenes>UI/Icons/Genes/BX_ArchogenesDark</backgroundPathEndogenes>
				<backgroundPathArchite>UI/Icons/Genes/BX_ArchogenesDark</backgroundPathArchite>
			</li>
		</modExtensions>
	</GeneDef>

	<GeneDef>
		<defName>BX_FoldSeverance</defName>
		<label>Fold Severance</label>
		<description>This gene allows the carrier to briefly slip out of phase with physical reality, becoming immune to physical damage and able to traverse solid barriers.</description>
		<geneClass>Bernael_Xenotype.Gene_Hexmaster</geneClass>
		<biostatCpx>4</biostatCpx>
		<biostatMet>0</biostatMet>
		<biostatArc>1</biostatArc>
		<displayCategory>BX_DarkEnergy</displayCategory>
		<abilities>
			<li>BX_FoldShift</li>
		</abilities>
		<descriptionHyperlinks>
			<AbilityDef>BX_FoldShift</AbilityDef>
		</descriptionHyperlinks>
		<displayOrderInCategory>-97</displayOrderInCategory>
		<iconPath>UI/Icons/Genes/BX_FoldSeverance</iconPath>
		<prerequisite>BX_SoulEater</prerequisite>
			<modExtensions>
		<li MayRequire="OskarPotocki.VanillaFactionsExpanded.Core" Class="VEF.Genes.GeneExtension">
			<backgroundPathXenogenes>UI/Icons/Genes/BX_ArchogenesDark</backgroundPathXenogenes>
			<backgroundPathEndogenes>UI/Icons/Genes/BX_ArchogenesDark</backgroundPathEndogenes>
			<backgroundPathArchite>UI/Icons/Genes/BX_ArchogenesDark</backgroundPathArchite>
		</li>
		</modExtensions>
	</GeneDef>
	
	<GeneDef>
		<defName>BX_PsychicReach</defName>
		<label>Psychic Reach</label>
		<description>This gene extends the reach of the carrier's psychic abilities, allowing them to affect targets from 25% farther away.</description>
		<geneClass>Gene</geneClass>
		<biostatCpx>2</biostatCpx>
		<biostatMet>0</biostatMet>
		<biostatArc>1</biostatArc>
		<displayCategory>BX_DarkEnergy</displayCategory>
		<displayOrderInCategory>-5</displayOrderInCategory>
		<iconPath>UI/Icons/Genes/BX_PsychicReach</iconPath>
	</GeneDef>
	
	<GeneDef>
		<defName>BX_Mastermind</defName>
		<label>Mastermind</label>
		<description>This gene enhances the carrier's psychic faculties, increasing psychic sensitivity, meditation efficiency, neural heat capacity, and neural heat recovery. Carriers can draw more power from their psycasts while enduring greater psychic strain and recovering from it more rapidly.</description>
		<geneClass>Gene</geneClass>
		<statFactors>
			<MeditationFocusGain>1.3</MeditationFocusGain>
			<PsychicEntropyMax>1.15</PsychicEntropyMax>
		</statFactors>
		<statOffsets>
			<PsychicSensitivity>0.4</PsychicSensitivity>
			<PsychicEntropyRecoveryRate>0.25</PsychicEntropyRecoveryRate>
		</statOffsets>
		<exclusionTags>
			<li>MeditationSpeed</li>
			<li>PsychicEntropy</li>
		</exclusionTags>
		<biostatCpx>4</biostatCpx>
		<biostatMet>0</biostatMet>
		<biostatArc>2</biostatArc>
		<displayCategory>BX_DarkEnergy</displayCategory>
		<displayOrderInCategory>-3</displayOrderInCategory>
		<iconPath>UI/Icons/Genes/BX_Mastermind</iconPath>
		<symbolPack>
			<prefixSymbols>
				<li>
					<symbol>psy</symbol>
					<weight>3</weight>
				</li>
				<li>
					<symbol>senso</symbol>
				</li>
				<li>
					<symbol>sensi</symbol>
				</li>
			</prefixSymbols>
		</symbolPack>
	</GeneDef>
	
	<GeneDef>
		<defName>BX_Hexmaster</defName>
		<label>Hexmaster</label>
		<description>This gene grants the carrier a psylink from birth and an additional level in the dark magic branch, marking them as a natural practitioner of forbidden psychic arts.</description>
		<geneClass>Bernael_Xenotype.Gene_Hexmaster</geneClass>
		<biostatCpx>4</biostatCpx>
		<biostatMet>0</biostatMet>
		<biostatArc>1</biostatArc>
		<displayCategory>BX_DarkEnergy</displayCategory>
		<displayOrderInCategory>-4</displayOrderInCategory>
		<iconPath>UI/Icons/Genes/BX_Hexmaster</iconPath>
	</GeneDef>


</Defs>
