<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <RecipeDef ParentName="SurgeryFlesh">
    <defName>BX_ExtractSoul</defName>
    <label>extract soul fragment</label>
    <description>Extract a soul fragment from the target. The operation will fail to produce a soul fragment if the target does not have enough blood.\n\nSoul fragments can be administered to satiate those who feed on blood.</description>
    <workerClass>Bernael_Xenotype.Recipe_ExtractSoul</workerClass>
    <jobString>Extracting soul fragment.</jobString>
    <workAmount>500</workAmount>
    <hideBodyPartNames>true</hideBodyPartNames>
    <targetsBodyPart>false</targetsBodyPart>
    <isViolation>true</isViolation>
    <descriptionHyperlinks>
      <ThingDef>BX_BottledSoul</ThingDef>
    </descriptionHyperlinks>
    <uiIconThing>BX_BottledSoul</uiIconThing>
    <anesthetize>false</anesthetize>
    <workSkillLearnFactor>2</workSkillLearnFactor>
  </RecipeDef>

  <RecipeDef ParentName="SurgeryFlesh">
    <defName>BX_SoulTransfusion</defName>
    <label>soul transfusion</label>
    <description>Pour bottled soul essence back into a drained target. Each bottle used recovers 35% of the soul drain. The operation will also restore soul energy to those who feed on souls.</description>
    <jobString>Performing soul transfusion on TargetA.</jobString>
    <workAmount>800</workAmount>
    <hideBodyPartNames>true</hideBodyPartNames>
    <targetsBodyPart>false</targetsBodyPart>
    <anesthetize>false</anesthetize>
    <workerClass>Bernael_Xenotype.Recipe_SoulTransfusion</workerClass>
    <surgeryOutcomeEffect IsNull="True" /> <!-- Always succeeds -->
    <descriptionHyperlinks>
      <ThingDef>BX_BottledSoul</ThingDef>
    </descriptionHyperlinks>
    <uiIconThing>BX_BottledSoul</uiIconThing>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>BX_BottledSoul</li>
          </thingDefs>
        </filter>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>BX_BottledSoul</li>
      </thingDefs>
    </fixedIngredientFilter>
  </RecipeDef>

</Defs>
