<Defs>

	<HediffDef MayRequire="Sov.Nephilim">
		<defName>BX_Mutation_Hediff</defName>
		<label>Mutation</label>
		<description>This Bernael has consumed grace and is undergoing a mutation, consuming grace daily will cause the mutation to progress until this Bernael becomes a Nephilim.</description>
		<hediffClass>Bernael_Xenotype.Hediff_BernaelToNephilim</hediffClass>
		<initialSeverity>1</initialSeverity>
		<minSeverity>0</minSeverity>
		<maxSeverity>1</maxSeverity>
		<!-- <lethalSeverity>1</lethalSeverity> -->
		<defaultLabelColor>(0.8, 0, 0.7)</defaultLabelColor>
		<makesSickThought>false</makesSickThought>
		<scenarioCanAdd>false</scenarioCanAdd>
		<isBad>false</isBad>
		<everCurableByItem>false</everCurableByItem>
		<keepOnBodyPartRestoration>True</keepOnBodyPartRestoration>
		<stages>
			<li>

			</li>
		</stages>
		<comps>
			<!-- <li Class="HediffCompProperties_Disappears"> -->
			<!-- <disappearsAfterTicks>601</disappearsAfterTicks> -->
			<!-- <showRemainingTime>false</showRemainingTime> -->
			<!-- </li> -->
		</comps>
	</HediffDef>

	<HediffDef>
		<defName>BX_Blindness</defName>
		<label>Missing Eye</label>
		<description>This xenotype has no eyes, just two decrepit holes.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<initialSeverity>1</initialSeverity>
		<minSeverity>0</minSeverity>
		<maxSeverity>1</maxSeverity>
		<!-- <lethalSeverity>1</lethalSeverity> -->
		<defaultLabelColor>(0.8, 0, 0.7)</defaultLabelColor>
		<makesSickThought>false</makesSickThought>
		<scenarioCanAdd>false</scenarioCanAdd>
		<isBad>false</isBad>
		<everCurableByItem>false</everCurableByItem>
		<keepOnBodyPartRestoration>True</keepOnBodyPartRestoration>
		<stages>
			<li>
				<partEfficiencyOffset>-1</partEfficiencyOffset>
			</li>
		</stages>
		<comps>
			<!-- <li Class="HediffCompProperties_Disappears"> -->
			<!-- <disappearsAfterTicks>601</disappearsAfterTicks> -->
			<!-- <showRemainingTime>false</showRemainingTime> -->
			<!-- </li> -->
		</comps>
	</HediffDef>

	<HediffDef>
		<defName>BX_WitheredSoulHediff</defName>
		<label>Withered Soul</label>
		<description>This person's withered soul causes worsening pain as their mood falls. The pain does not reduce their mood.</description>
		<hediffClass>Bernael_Xenotype.Hediff_SeverityBasedOnNeed</hediffClass>
		<initialSeverity>1</initialSeverity>
		<minSeverity>0</minSeverity>
		<maxSeverity>1</maxSeverity>
		<!-- <lethalSeverity>1</lethalSeverity> -->
		<makesSickThought>false</makesSickThought>
		<scenarioCanAdd>false</scenarioCanAdd>
		<isBad>false</isBad>
		<everCurableByItem>false</everCurableByItem>
		<keepOnBodyPartRestoration>True</keepOnBodyPartRestoration>
		<stages>
			<li>
				<becomeVisible>true</becomeVisible>
				<painOffset>0.35</painOffset>
				<label>Huge pain</label>
				<minSeverity>0</minSeverity>
			</li>
			<li>
				<becomeVisible>true</becomeVisible>
				<painOffset>0.25</painOffset>
				<label>Serious pain</label>
				<minSeverity>0.3</minSeverity>
			</li>
			<li>
				<becomeVisible>true</becomeVisible>
				<painOffset>0.15</painOffset>
				<label>Aching pain</label>
				<minSeverity>0.6</minSeverity>
			</li>
			<li>
				<becomeVisible>false</becomeVisible>
				<label>Absence of pain</label>
				<minSeverity>0.9</minSeverity>
			</li>
		</stages>
		<modExtensions>
			<li Class="Bernael_Xenotype.ModExt_SeverityBasedOnNeed">
				<severityFromNeed>
					<needDef>Mood</needDef>
					<severity>
						<points>
							<li>(0, 0.1)</li>
							<li>(1, 1)</li>
						</points>
					</severity>
				</severityFromNeed>
			</li>
		</modExtensions>
	</HediffDef>

<HediffDef>
	<defName>BX_ReaperEcstasy</defName>
	<label>Reaper's Ecstasy</label>
		<description>Every living creature killed by this Bernael restores 10% Soul Saturation. Hostile kills also feed Reaper's Ecstasy, increasing psychic prowess and refreshing its shared decay timer. Without another hostile kill, the effect loses one level per hour.</description>
	<hediffClass>Bernael_Xenotype.Hediff_ReapersEcstasy</hediffClass>
	<initialSeverity>1</initialSeverity>
	<minSeverity>0</minSeverity>
	<maxSeverity>100</maxSeverity>
	<!-- <lethalSeverity>1</lethalSeverity> -->
	<defaultLabelColor>(0.8, 0, 0.7)</defaultLabelColor>
	<makesSickThought>false</makesSickThought>
	<scenarioCanAdd>false</scenarioCanAdd>
	<isBad>false</isBad>
	<everCurableByItem>false</everCurableByItem>
	<keepOnBodyPartRestoration>True</keepOnBodyPartRestoration>
	<stages>
		<li>
			<!-- x = Severity, y = stat factor -->
			<statFactorsBySeverity>
				<li>
					<stat>PsychicSensitivity</stat>
					<valueBySeverity>
						<points>
							<li>(0, 1)</li>
							<li>(1, 1)</li>
							<li>(100, 0.1)</li>
						</points>
					</valueBySeverity>
				</li>
				<!--<li MayRequire="Ludeon.Rimworld.Royalty">
					<stat>PsychicEntropyGain</stat>
					<valueBySeverity>
						<points>
							<li>(0, 1)</li>
							<li>(1, 1)</li>
							<li>(100, 0.1)</li>
						</points>
					</valueBySeverity>
				</li>-->
				<li MayRequire="Ludeon.Rimworld.Royalty">
					<stat>PsychicEntropyMax</stat>
					<valueBySeverity>
						<points>
							<li>(0, 1)</li>
							<li>(1, 1)</li>
							<li>(100, 1.25)</li>
						</points>
					</valueBySeverity>
				</li>
			</statFactorsBySeverity>
		</li>
	</stages>
	<modExtensions>
		<li Class="Bernael_Xenotype.ReaperModExt">
			<killRefillPct>10</killRefillPct>
			<decayTickInterval>2500</decayTickInterval>
		</li>
	</modExtensions>
	<comps>
		<!-- <li Class="HediffCompProperties_Disappears"> -->
		<!-- <disappearsAfterTicks>601</disappearsAfterTicks> -->
		<!-- <showRemainingTime>false</showRemainingTime> -->
		<!-- </li> -->
	</comps>
</HediffDef>

</Defs>
