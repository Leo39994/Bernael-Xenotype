<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <SoundDef>
    <defName>BX_Ambient_Gaze</defName>
    <context>MapOnly</context>
    <maxSimultaneous>1</maxSimultaneous>
    <sustain>True</sustain>
    <priorityMode>PrioritizeNearest</priorityMode>
    <sustainFadeoutTime>0.35</sustainFadeoutTime>
    <subSounds>
      <li>
        <onCamera>True</onCamera>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>GazeCaligo/Amb_Gaze_Loop</clipPath>
          </li>
        </grains>
        <volumeRange>48</volumeRange>
        <pitchRange>1</pitchRange>
        <distRange>14~40</distRange>
        <muteWhenPaused>true</muteWhenPaused>
        <sustainLoop>true</sustainLoop>
        <sustainAttack>0.4</sustainAttack>
        <sustainSkipFirstAttack>false</sustainSkipFirstAttack>
      </li>
    </subSounds>
  </SoundDef>

  <SoundDef>
    <defName>BX_Gaze_Blink</defName>
    <context>MapOnly</context>
    <maxSimultaneous>1</maxSimultaneous>
    <priorityMode>PrioritizeNearest</priorityMode>
    <subSounds>
      <li>
        <onCamera>True</onCamera>
        <grains>
          <li Class="AudioGrain_Folder">
            <clipFolderPath>GazeCaligo/Gaze_Blink</clipFolderPath>
          </li>
        </grains>
        <volumeRange>120</volumeRange>
        <pitchRange>0.9~1.1</pitchRange>
        <distRange>14~40</distRange>
        <muteWhenPaused>true</muteWhenPaused>
      </li>
    </subSounds>
  </SoundDef>

  <SoundDef>
    <defName>BX_Gaze_Move</defName>
    <context>MapOnly</context>
    <maxSimultaneous>1</maxSimultaneous>
    <sustain>True</sustain>
    <priorityMode>PrioritizeNearest</priorityMode>
    <sustainFadeoutTime>0.35</sustainFadeoutTime>
    <subSounds>
      <li>
        <onCamera>True</onCamera>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>GazeCaligo/Amb_Gaze_Loop</clipPath>
          </li>
        </grains>
        <volumeRange>72</volumeRange>
        <pitchRange>0.4~0.6</pitchRange>
        <distRange>14~40</distRange>
        <muteWhenPaused>True</muteWhenPaused>
      </li>
    </subSounds>
  </SoundDef>

</Defs>