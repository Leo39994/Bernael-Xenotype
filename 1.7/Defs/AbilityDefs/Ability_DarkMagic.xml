<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Royalty psycasts; the dedicated dev actions grant them immediately. -->
  <AbilityDef MayRequire="Ludeon.RimWorld.Royalty">
    <defName>BX_MaliciousSeal</defName>
    <label>malicious seal</label>
    <description>Brand an ancient seal of malice on the target's mind for 30 seconds. Every second its daggers pierce the skull at its heart.\n\nA sealed creature cannot cast psycasts or use any other ability, and a cast it is preparing is broken. It suffers constant pain and takes 50% more damage from cursed flame. If it dies before the brand fades, the seal leaps from its corpse to up to three hostile minds nearby.\n\nTargets without psychic sensitivity cannot be sealed.</description>
    <abilityClass>RimWorld.Psycast</abilityClass>
    <category>Psychic</category>
    <level>3</level>
    <iconPath>UI/Icons/Abilities/BX_MaliciousSeal</iconPath>
    <writeCombatLog>true</writeCombatLog>
    <cooldownTicksRange>1800</cooldownTicksRange>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>
    <targetRequired>true</targetRequired>
    <warmupSound>BX_Cast1</warmupSound>
    <statBases>
      <Ability_PsyfocusCost>0.03</Ability_PsyfocusCost>
      <Ability_EntropyGain>32</Ability_EntropyGain>
    </statBases>
    <verbProperties>
      <verbClass>RimWorld.Verb_CastPsycast</verbClass>
      <range>24.9</range>
      <warmupTime>1.2</warmupTime>
      <requireLineOfSight>true</requireLineOfSight>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetLocations>false</canTargetLocations>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetSelf>false</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="Bernael_Xenotype.CompProperties_MaliciousSeal">
        <psychic>true</psychic>
        <goodwillImpact>-15</goodwillImpact>
        <brandSound>PsycastPsychicPulse</brandSound>
      </li>
    </comps>
    <modExtensions>
      <li Class="Bernael_Xenotype.PsycastGeneRequirementExtension">
        <requireHexmaster>true</requireHexmaster>
      </li>
    </modExtensions>
  </AbilityDef>

  <AbilityDef MayRequire="Ludeon.RimWorld.Royalty">
    <defName>BX_DireOrb</defName>
    <label>dire orb</label>
    <description>Fire a heavy orb of darkness wreathed in cursed flame at a location. The orb collapses on impact and bursts in a wave of pale fire that batters nearby hostiles and leaves them staggering. The blast is weaker toward its edge and does not pass through walls.\n\nCursed flames linger on dry, unobstructed ground, burning standing enemies that enter them. Their damage is increased by Malicious seal. Downed creatures are spared. A standing ally is affected only if struck directly by the orb.\n\nA shield that intercepts the orb swallows both the blast and its lingering fire.</description>
    <abilityClass>RimWorld.Psycast</abilityClass>
    <category>Psychic</category>
    <level>3</level>
    <iconPath>UI/Icons/Abilities/BX_DireOrb</iconPath>
    <cooldownTicksRange>1200</cooldownTicksRange>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>
    <targetRequired>true</targetRequired>
    <canUseAoeToGetTargets>false</canUseAoeToGetTargets>
    <warmupSound>BX_Cast1</warmupSound>
    <statBases>
      <Ability_PsyfocusCost>0.03</Ability_PsyfocusCost>
      <Ability_EntropyGain>35</Ability_EntropyGain>
    </statBases>
    <verbProperties>
      <verbClass>RimWorld.Verb_CastPsycast</verbClass>
      <range>24.9</range>
      <warmupTime>1</warmupTime>
      <requireLineOfSight>true</requireLineOfSight>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetSelf>false</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="Bernael_Xenotype.CompProperties_DireOrb">
        <!-- The blast radius is the projectile's explosionRadius. -->
        <projectileDef>BX_DireOrbProjectile</projectileDef>
      </li>
    </comps>
    <modExtensions>
      <li Class="Bernael_Xenotype.PsycastGeneRequirementExtension">
        <requireHexmaster>true</requireHexmaster>
      </li>
    </modExtensions>
  </AbilityDef>
</Defs>
