<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <Bernael_Xenotype.AbilityDef_Toggle>
    <defName>BX_FoldShift</defName>
    <label>fold shift</label>
    <description>Shift out of physical reality, becoming a shadow that moves slowly and resists physical harm. While active, the shift drains soul essence and allows Traverse the Fold. EMP forces the shift to end and stuns the carrier. Leaving the shifted state causes severe shock.</description>
    <abilityClass>Bernael_Xenotype.Ability_ToggleHediff</abilityClass>
    <showPsycastEffects>false</showPsycastEffects>
    <hostile>false</hostile>
    <toggleHediffDef>BX_FoldShift_Hediff</toggleHediffDef>
    <iconPath>UI/Icons/Abilities/BX_FoldShift</iconPath>
		<category>Bernael</category>
    <cooldownTicksRange>240</cooldownTicksRange>
		<targetRequired>false</targetRequired>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <warmupSound>PsycastCastLoop</warmupSound>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>0.25</warmupTime>
      <range>-1</range>
      <drawAimPie>False</drawAimPie>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetAnimals>false</canTargetAnimals>
        <canTargetHumans>false</canTargetHumans>
        <canTargetMechs>false</canTargetMechs>
      </targetParams>
    </verbProperties>
    <jobDef>BX_CastAbilityOnThing_KeepCarrying</jobDef>
    <comps>
      <li Class="Bernael_Xenotype.CompProperties_AbilitySoulCostPerSecond">
        <soulCostPerSecond>0.02</soulCostPerSecond>
      </li>
    </comps>
  </Bernael_Xenotype.AbilityDef_Toggle>

  <AbilityDef ParentName="AbilityTouchBase">
    <defName>BX_TraverseTheFold</defName>
    <showPsycastEffects>false</showPsycastEffects>
    <hostile>false</hostile>
    <label>traverse the fold</label>
    <description>Phase through solid matter along a straight line, passing through up to 5 walls or obstacles. Blocked by special barriers, such as ancient fortified walls, and impassable terrain.</description>
    <iconPath>UI/Icons/Abilities/BX_TraverseTheFold</iconPath>
		<category>Bernael</category>
    <cooldownTicksRange>3000</cooldownTicksRange>
		<targetRequired>true</targetRequired>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <warmupSound>PsycastCastLoop</warmupSound>
    <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>0.25</warmupTime>
      <range>1.0</range>
      <drawAimPie>False</drawAimPie>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>true</canTargetBuildings>
        <canTargetAnimals>false</canTargetAnimals>
        <canTargetHumans>false</canTargetHumans>
        <canTargetMechs>false</canTargetMechs>
      </targetParams>
    </verbProperties>
    <jobDef>BX_CastAbilityOnThing_KeepCarrying</jobDef>
    <comps>
      <li Class="Bernael_Xenotype.CompProperties_AbilityRequiresHediff">
        <requiresHediffDef>BX_FoldShift_Hediff</requiresHediffDef>
        <hideGizmoOnUndesirable>false</hideGizmoOnUndesirable>
      </li>
      <li Class="Bernael_Xenotype.CompProperties_AbilityTraverseTheFold">
        <maxPassWall>5</maxPassWall>
      </li>
    </comps>
  </AbilityDef>

</Defs>
