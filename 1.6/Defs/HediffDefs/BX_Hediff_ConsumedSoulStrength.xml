<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>BX_ConsumedSoulStrength</defName>
    <label>soul absorption</label>
    <description>Absorbed soul energy heightens consciousness by 20% and reduces incoming damage by 10% for one day. Absorbing another soul refreshes the duration.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <stages>
      <li>
        <statFactors>
          <IncomingDamageFactor>0.9</IncomingDamageFactor>
        </statFactors>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <postFactor>1.2</postFactor>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>
</Defs>
