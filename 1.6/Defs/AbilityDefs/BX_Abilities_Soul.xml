<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <AbilityCategoryDef>
		<defName>Bernael</defName>
		<displayOrder>1000</displayOrder>
	</AbilityCategoryDef>

	<AbilityDef ParentName="AbilityTouchBase">
		<defName>BX_SoulFeeding</defName>
		<label>Soul drain</label>
		<description>Draw out a nearby person's life essence. Red-black smoke surrounds a cyan soul in the target's own shape, pulling it directly from their body into the caster's eyes. The target gradually loses color and temporarily turns charcoal gray. Soul drain weakens the target and repeated feeding can be fatal.\n\nCan only target non-soulstarved humans. Soul gain is affected by the target's body size.</description>
		<iconPath>UI/Icons/Genes/BX_LifeDrain</iconPath>
		<category>Bernael</category>
		<displayOrder>100</displayOrder>
		<jobDef>CastAbilityOnThing</jobDef>
		<warmupStartSound>Bloodfeed_Cast</warmupStartSound>
		<hostile>false</hostile>
		<casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
		<verbProperties>
			<verbClass>Verb_CastAbility</verbClass>
			<drawAimPie>false</drawAimPie>
			<range>3.9</range>
			<warmupTime>2</warmupTime>
			<targetParams>
				<canTargetSelf>false</canTargetSelf>
				<canTargetBuildings>false</canTargetBuildings>
				<canTargetMechs>false</canTargetMechs>
				<canTargetBloodfeeders>false</canTargetBloodfeeders>
			</targetParams>
		</verbProperties>
		<comps>
			<li Class="Bernael_Xenotype.CompProperties_AbilitySoulDrain">
				<soulGain>0.2</soulGain>
				<thoughtDefToGiveTarget>BX_FedOn</thoughtDefToGiveTarget>
				<opinionThoughtDefToGiveTarget>BX_FedOn_Social</opinionThoughtDefToGiveTarget>
				<resistanceGain>1</resistanceGain>
				<hediffToGiveTarget>BX_SoulDrained</hediffToGiveTarget>
				<hediffSeverity>0.4499</hediffSeverity>
			</li>
			<li Class="CompProperties_AbilityRequiresCapacity">
				<capacity>Manipulation</capacity>
			</li>
		</comps>
	</AbilityDef>

</Defs>
