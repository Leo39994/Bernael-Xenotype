<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{D99D612E-745F-4381-AB4F-A91F4DA8A3E2}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>Bernael_Xenotype</RootNamespace>
    <AssemblyName>Bernael Xenotype</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>latest</LangVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>..\Assemblies\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>..\Assemblies\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup>
    <RimWorldManagedDir Condition=" '$(RimWorldManagedDir)' == '' And '$(RimWorldDir)' != '' And Exists('$(RimWorldDir)\RimWorldWin64_Data\Managed') ">$(RimWorldDir)\RimWorldWin64_Data\Managed</RimWorldManagedDir>
    <RimWorldManagedDir Condition=" '$(RimWorldManagedDir)' == '' And Exists('C:\Program Files %28x86%29\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed') ">C:\Program Files %28x86%29\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManagedDir>
    <RimWorldManagedDir Condition=" '$(RimWorldManagedDir)' == '' And Exists('C:\Program Files\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed') ">C:\Program Files\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManagedDir>
    <RimWorldManagedDir Condition=" '$(RimWorldManagedDir)' == '' And Exists('D:\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed') ">D:\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManagedDir>
    <RimWorldManagedDir Condition=" '$(RimWorldManagedDir)' == '' And Exists('E:\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed') ">E:\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManagedDir>
  </PropertyGroup>

  <Target Name="VerifyRimWorldManagedDir" BeforeTargets="BeforeBuild">
    <Error Condition=" '$(RimWorldManagedDir)' == '' " Text="RimWorld-Installation nicht gefunden. Build mit -p:RimWorldDir=&quot;X:\Pfad\zu\RimWorld&quot; aufrufen oder RimWorldManagedDir direkt setzen." />
  </Target>

  <ItemGroup>
    <Compile Include="Bernael\**\*.cs" />
  </ItemGroup>

  <!-- Dark Mirage psycast. Keeps its own namespace Bernael.DarkMirageDemo so the defs and
       saved decoys (<thing Class="Bernael.DarkMirageDemo.DarkMirage">) stay valid. -->
  <ItemGroup>
    <Compile Include="DarkMirageDemo\DarkMirage.cs" />
    <Compile Include="DarkMirageDemo\MirageVisuals.cs" />
    <Compile Include="DarkMirageDemo\DebugActions.cs" />
    <Compile Include="DarkMirageUnity\Assets\Shared\MirageDistanceField.cs" />
    <Compile Include="DarkMirageDemo\MirageQaHarness.cs" Condition=" $(DefineConstants.Contains('MIRAGE_QA')) And Exists('DarkMirageDemo\MirageQaHarness.cs') " />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule" Condition=" $(DefineConstants.Contains('MIRAGE_QA')) ">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.ScreenCaptureModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony">
      <Version>2.4.2</Version>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
