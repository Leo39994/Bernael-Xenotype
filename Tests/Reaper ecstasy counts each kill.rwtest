rwtest 1
test "Reaper ecstasy counts each kill" project="Bernael" group="Genes" created=2026-09-20T00:00:00

requires dlc=Biotech

speed paused
spawn Pawn:Colonist at 0,0 name="Bernael" xenotype=BX_Bernael
spawn Pawn:Pirate at 4,0 name="First" faction=enemy
spawn Pawn:Pirate at 6,0 name="Second" faction=enemy

give "Bernael" resource=BX_SoulStarved value=0.1
assert pawn "Bernael" hediff=BX_ReaperEcstasy severity min=1 max=1

damage "First" amount=999 by="Bernael"
assert pawn "First" dead
assert pawn "Bernael" hediff=BX_ReaperEcstasy severity min=2 max=2
assert pawn "Bernael" resource=BX_SoulStarved min=0.15 max=0.25

damage "Second" amount=999 by="Bernael"
assert pawn "Second" dead
assert pawn "Bernael" hediff=BX_ReaperEcstasy severity min=3 max=3
assert pawn "Bernael" resource=BX_SoulStarved min=0.25 max=0.35

assert log clean
