rwtest 1
test "Bernael art - body, head, warlock gear, lantern glow, projectile arc" project="Bernael" created=2026-09-18T00:00:00

requires mod=Mortis.BX
requires dlc=Biotech
spawn Pawn:Colonist at 0,0 name="Bernael" xenotype=BX_Bernael
spawn Pawn:Colonist at 3,0 name="Baseline"

tick 30 note="body and head block: one render frame after the pawn graphics were built"
ask "bernael-body" claim="the left pawn has the halo above the head, the wings behind the body and withered skin, all three drawn in the right layer and none of them on the plain colonist to the right"
ask "depraved-head" claim="the left pawn's head is the depraved head: no eyes are drawn on it, and it differs from the vanilla head on the right"

spawn Thing:BX_Apparel_Warlock at 1,2
spawn Thing:BX_Headgear_Warlock at 2,2
spawn Thing:BX_SoulLantern at 4,2
wear "Bernael" apparel=BX_Apparel_Warlock
wear "Bernael" apparel=BX_Headgear_Warlock
equip "Bernael" thing=BX_SoulLantern

tick 30 note="warlock gear block: one render frame after the graphics were set"
ask "warlock-gear-south" claim="the left pawn wears the warlock robe and headgear and holds the lantern; the headgear sits over the head, not under it, and nothing is cut off or stretched"

draft "Bernael"
tick 30 note="lantern glow block: one render frame with a drafted pawn"
ask "lantern-glow-drafted" claim="the drafted pawn holds the lantern and it throws a glow onto the ground around it"

undraft "Bernael"
speed paused
spawn Pawn:Colonist at 0,8 name="Arcer" xenotype=BX_Bernael
spawn Pawn:Pirate at 8,8 name="Pirate A" faction=enemy
spawn Pawn:Pirate at 8,11 name="Pirate B" faction=enemy
pacify "Pirate A"
pacify "Pirate B"
speed x1
spawn Thing:BX_SoulLantern at 1,8
equip "Arcer" thing=BX_SoulLantern

down "Pirate A"
attack "Arcer" target="Pirate A"

ask "lantern-projectile-arc" ticks=600 claim="the bullet leaves the muzzle on a visible curve, not a straight line, and while it is already in the air it turns away from the downed Pirate A towards Pirate B"
