rwtest 1
test "Drain chain counts no kill" project="Bernael" group="Soul" created=2026-09-18T00:00:00

# Three drains push BX_SoulDrained past lethalSeverity 1 and the victim dies of
# the hediff, not of the caster. Hediff_ReapersEcstasy.Notify_KilledPawn never
# fires, so draining someone dry scores no kill - unlike shooting them. The
# test does not judge that, it only pins it down.
#
# Each drain is a player's: the "Soul drain" gizmo, a click on the victim, and
# then Bernael walks over and runs the 120-tick warmup. Every drain waits for
# its own severity step before the next gizmo press, 300 ticks at most for
# warmup, walk and slack. BX_SoulFeeding has no cooldownTicksRange, and neither
# has AbilityTouchBase, so the gizmo is usable again the moment a drain landed.
#
# The second and third drain open CompAbilityEffect_SoulDrain.ConfirmationDialog
# the way they do for a player: 0.8998 is stage extreme (lifeThreatening), and
# 1.3497 is past lethalSeverity. Both are answered with "Confirm", as in "Drain
# gizmo asks first". The last wait is the old 300-tick budget for the hediff to
# kill, plus the warmup and walk in front of it.

requires dlc=Biotech
spawn Pawn:Colonist at 0,0 name="Bernael" xenotype=BX_Bernael
spawn Pawn:Colonist at 2,0 name="Victim"
give "Bernael" resource=BX_SoulStarved value=0.1

select "Bernael"
gizmo "Soul drain"
target "Victim"
waitfor pawn "Victim" hediff=BX_SoulDrained severity min=0.44 ticks=300

gizmo "Soul drain"
target "Victim"
click "Confirm"
waitfor pawn "Victim" hediff=BX_SoulDrained severity min=0.89 ticks=300

gizmo "Soul drain"
target "Victim"
click "Confirm"
waitfor pawn "Victim" dead ticks=600

assert pawn "Victim" dead
assert pawn "Bernael" hediff=BX_ReaperEcstasy severity max=1
