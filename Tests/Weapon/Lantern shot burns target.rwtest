rwtest 1
test "Lantern shot burns target" project="Bernael" created=2026-09-17T00:00:00

requires dlc=Biotech
speed paused
spawn Pawn:Colonist at 0,0 name="Bernael" xenotype=BX_Bernael
spawn Pawn:Pirate at 6,0 name="Pirate" faction=enemy
pacify "Pirate"
speed x1
spawn Thing:BX_SoulLantern at 1,0
equip "Bernael" thing=BX_SoulLantern

attack "Bernael" target="Pirate"
assert pawn "Bernael" job=AttackStatic expect=present

waitfor pawn "Pirate" hediff=Burn ticks=1320 expect=present
assert shots "Bernael" min=1
