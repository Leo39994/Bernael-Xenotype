rwtest 1
test "Lantern buffs sensitivity" project="Bernael" created=2026-09-17T00:00:00

requires dlc=Biotech
spawn Pawn:Colonist at 0,0 name="Bernael" xenotype=BX_Bernael
spawn Thing:BX_SoulLantern at 1,0

equip "Bernael" thing=BX_SoulLantern
assert pawn "Bernael" equipment=BX_SoulLantern expect=present
assert pawn "Bernael" stat=PsychicSensitivity min=1.25 expect=present

select "Bernael"
draft "Bernael"
assert text contains "Soul Saturation" expect=present
