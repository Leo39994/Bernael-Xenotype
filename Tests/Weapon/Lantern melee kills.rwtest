rwtest 1
test "Lantern melee kills" project=Bernael created=2026-09-17T00:00:00

requires dlc=Biotech
speed paused
spawn Pawn:Colonist at 0,0 name="Bernael" xenotype=BX_Bernael
spawn Pawn:Pirate at 1,0 name="Pirate" faction=enemy
pacify "Pirate"
speed x1
spawn Thing:BX_SoulLantern at 0,1 name="lantern"
equip "Bernael" thing="lantern"
damage "Pirate" amount=30
down "Pirate"
draft "Bernael"
attack "Bernael" target="Pirate" melee=true
assert pawn "Bernael" drafted expect=present
assert pawn "Bernael" job=AttackMelee expect=present
waitfor pawn "Pirate" dead ticks=2500 expect=present
undraft "Bernael"
assert log clean
