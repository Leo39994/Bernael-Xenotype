rwtest 1
test "Drain raises prisoner resistance" project="Bernael" group="Soul" created=2026-09-18T00:00:00

requires dlc=Biotech
spawn Pawn:Colonist at 0,0 name="Bernael" xenotype=BX_Bernael
spawn Pawn:Colonist at 2,0 name="Prisoner"
prisoner "Prisoner" resistance=10
give "Bernael" resource=BX_SoulStarved value=0.1

select "Bernael"
gizmo "Soul drain"
target "Prisoner"
waitfor pawn "Prisoner" hediff=BX_SoulDrained expect=present ticks=300

assert pawn "Prisoner" hediff=BX_SoulDrained expect=present
assert pawn "Prisoner" resistance min=11 max=11
assert log clean
