rwtest 1
test "Save roundtrip keeps state" project="Bernael" created=2026-09-17T00:00:00

requires dlc=Biotech
spawn Pawn:Colonist at 0,0 name="Bernael" xenotype=BX_Bernael
spawn Thing:BX_SoulLantern at 1,0
equip "Bernael" thing=BX_SoulLantern
give "Bernael" resource=BX_SoulStarved value=0.42

reload note="save, load, everything has to still be there"

assert pawn "Bernael" hediff=BX_Blindness expect=present
assert pawn "Bernael" resource=BX_SoulStarved min=0.41 max=0.43 expect=present
assert pawn "Bernael" capacity=Sight min=1.25 expect=present
assert pawn "Bernael" equipment=BX_SoulLantern expect=present
