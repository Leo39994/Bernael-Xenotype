rwtest 1
test "Soul drain confirmation - asks first, going back spares, chain counts no kill" project="Bernael" created=2026-09-18T00:00:00

requires dlc=Biotech
speed paused
spawn Pawn:Colonist at 0,0 name="Asker" xenotype=BX_Bernael
spawn Pawn:Colonist at 2,0 name="Asked"

give "Asker" resource=BX_SoulStarved value=0.1
give "Asked" hediff=BX_SoulDrained severity=0.5

select "Asker"
gizmo "Soul drain" expect=allowed
target "Asked" expect=allowed

assert window Dialog_MessageBox contains "serious soul damage" expect=present
click "Confirm"

speed x1
waitfor pawn "Asked" hediff=BX_SoulDrained severity min=0.89 ticks=300 expect=present

speed paused
spawn Pawn:Colonist at 0,6 name="Hesitant" xenotype=BX_Bernael
spawn Pawn:Colonist at 2,6 name="Spared"

give "Hesitant" resource=BX_SoulStarved value=0.1
give "Spared" hediff=BX_SoulDrained severity=0.56

select "Hesitant"
gizmo "Soul drain" expect=allowed
target "Spared" expect=allowed

assert window Dialog_MessageBox contains "will kill" expect=present
click "Go back"

speed x1
tick 300 note="go back block: 4 s warmup is 240 ticks, plus the job that carries it, in case the cast went through anyway"
assert pawn "Spared" hediff=BX_SoulDrained severity max=0.57 expect=present
assert pawn "Hesitant" resource=BX_SoulStarved max=0.11 expect=present

speed paused
spawn Pawn:Colonist at 0,12 name="Chainer" xenotype=BX_Bernael
spawn Pawn:Colonist at 2,12 name="Chained"
give "Chainer" resource=BX_SoulStarved value=0.1

select "Chainer"
gizmo "Soul drain" expect=allowed
target "Chained" expect=allowed
speed x1
waitfor pawn "Chained" hediff=BX_SoulDrained severity min=0.44 ticks=300 expect=present
waitfor pawn "Chainer" job=CastAbilityOnThing ticks=60 expect=absent

speed paused
gizmo "Soul drain" expect=allowed
target "Chained" expect=allowed
click "Confirm"
waitfor pawn "Chained" hediff=BX_SoulDrained severity min=0.89 ticks=300 expect=present
waitfor pawn "Chainer" job=CastAbilityOnThing ticks=60 expect=absent

speed paused
gizmo "Soul drain" expect=allowed
target "Chained" expect=allowed
click "Confirm"
waitfor pawn "Chained" dead ticks=600 expect=present

assert pawn "Chained" dead expect=present
assert pawn "Chainer" hediff=BX_ReaperEcstasy severity max=1 expect=present
