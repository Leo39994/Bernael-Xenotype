rwtest 1
test "Empty soul starts craving" project="Bernael" created=2026-09-17T00:00:00

requires dlc=Biotech
spawn Pawn:Colonist at 0,0 name="Bernael" xenotype=BX_Bernael

give "Bernael" resource=BX_SoulStarved value=0.0005
waitfor pawn "Bernael" hediff=BX_SoulCraving ticks=900 expect=present

tick 2500 note="one game hour, severityPerHourEmpty 0.25"
assert pawn "Bernael" hediff=BX_SoulCraving severity min=0.2 expect=present
