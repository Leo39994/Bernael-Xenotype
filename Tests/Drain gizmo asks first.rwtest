rwtest 1
test "Drain gizmo asks first" project="Bernael" group="Soul" created=2026-09-17T00:00:00

requires dlc=Biotech
spawn Pawn:Colonist at 0,0 name="Bernael" xenotype=BX_Bernael
spawn Pawn:Colonist at 2,0 name="Victim"

give "Bernael" resource=BX_SoulStarved value=0.1
give "Victim" hediff=BX_SoulDrained severity=0.5

select "Bernael"
gizmo "Soul drain"
target "Victim"

assert window Dialog_MessageBox contains "serious soul damage" expect=present
click "Confirm"

tick 180 reason="120 ticks warmup plus slack"
assert pawn "Victim" hediff=BX_SoulDrained expect=present
