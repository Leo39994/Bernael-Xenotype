rwtest 1
test "Gene removal ends psychic sight" project="Bernael" group="Sight" created=2026-09-18T00:00:00

requires dlc=Biotech
spawn Pawn:Colonist at 0,0 name="Bernael" xenotype=BX_Bernael
assert pawn "Bernael" hediff=BX_Blindness expect=present
assert pawn "Bernael" capacity=Sight min=1.25

gene "Bernael" remove=BX_DepravedHead

assert pawn "Bernael" hediff=BX_Blindness expect=absent
assert pawn "Bernael" capacity=Sight max=1
