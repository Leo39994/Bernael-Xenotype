rwtest 1
test "Reaper ecstasy bends entropy" project="Bernael" group="Soul" created=2026-09-19T00:00:00

requires dlc=Biotech
requires dlc=Royalty
spawn Pawn:Colonist at 0,0 name="Bernael" xenotype=BX_Bernael

assert pawn "Bernael" stat=PsychicEntropyGain min=0.98 max=1.02

give "Bernael" hediff=BX_ReaperEcstasy severity=50
assert pawn "Bernael" hediff=BX_ReaperEcstasy expect=present
assert pawn "Bernael" stat=PsychicEntropyGain min=0.50 max=0.61

give "Bernael" hediff=BX_ReaperEcstasy severity=100
assert pawn "Bernael" stat=PsychicEntropyGain min=0.08 max=0.12

assert log clean
