rwtest 1
test "Warlock gear and lantern - pain shock, full loadout, lantern sensitivity" project="Bernael" created=2026-09-19T00:00:00

requires mod=Mortis.BX
requires dlc=Biotech
spawn Pawn:Colonist at 0,0 name="Robed" xenotype=BX_Bernael
spawn Pawn:Colonist at 0,4 name="Warlock" xenotype=BX_Bernael
spawn Pawn:Colonist at 0,8 name="Holder" xenotype=BX_Bernael

assert pawn "Robed" stat=PainShockThreshold min=0.78 max=0.82 expect=present
assert pawn "Robed" stat=PsychicSensitivity max=2.0 expect=present

spawn Thing:BX_Headgear_Warlock at 2,0
spawn Thing:BX_Apparel_Warlock at 3,0
wear "Robed" apparel=BX_Headgear_Warlock
assert pawn "Robed" apparel=BX_Headgear_Warlock expect=present
assert pawn "Robed" stat=PainShockThreshold min=0.83 max=0.87 expect=present

wear "Robed" apparel=BX_Apparel_Warlock
assert pawn "Robed" apparel=BX_Apparel_Warlock expect=present
assert pawn "Robed" stat=PainShockThreshold min=0.93 max=0.97 expect=present
assert pawn "Robed" stat=PsychicSensitivity min=2.05 expect=present

give "Warlock" need=Mood value=0.95
waitfor pawn "Warlock" hediff=BX_WitheredSoulHediff severity min=0.9 ticks=480 expect=present
assert pawn "Warlock" stat=PsychicSensitivity max=2.0 expect=present
assert pawn "Warlock" stat=PsychicEntropyRecoveryRate min=0.74 max=0.84 expect=present

spawn Thing:BX_Headgear_Warlock at 2,4
spawn Thing:BX_Apparel_Warlock at 3,4
spawn Thing:BX_SoulLantern at 4,4
wear "Warlock" apparel=BX_Headgear_Warlock
wear "Warlock" apparel=BX_Apparel_Warlock
equip "Warlock" thing=BX_SoulLantern

assert pawn "Warlock" apparel=BX_Headgear_Warlock expect=present
assert pawn "Warlock" apparel=BX_Apparel_Warlock expect=present
assert pawn "Warlock" equipment=BX_SoulLantern expect=present

give "Warlock" need=Mood value=0.95
waitfor pawn "Warlock" hediff=BX_WitheredSoulHediff severity min=0.9 ticks=480 expect=present

assert pawn "Warlock" stat=PsychicSensitivity min=2.3 expect=present
assert pawn "Warlock" stat=PsychicEntropyRecoveryRate min=0.91 max=1.01 expect=present

assert pawn "Holder" stat=PsychicSensitivity max=2.0 expect=present
spawn Thing:BX_SoulLantern at 1,8
equip "Holder" thing=BX_SoulLantern
assert pawn "Holder" equipment=BX_SoulLantern expect=present
assert pawn "Holder" stat=PsychicSensitivity min=1.25 expect=present
assert pawn "Holder" stat=PsychicSensitivity min=1.6 expect=present

select "Holder"
draft "Holder"
assert text contains "Soul Saturation" expect=present

give "Holder" hediff=BX_ReaperEcstasy severity=50
assert pawn "Holder" stat=PsychicSensitivity min=5 expect=present

undraft "Holder"
assert log clean
