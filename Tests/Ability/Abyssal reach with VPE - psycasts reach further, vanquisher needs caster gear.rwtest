rwtest 1
test "Abyssal reach with VPE - psycasts reach further, vanquisher needs caster gear" project="Bernael" created=2026-11-01T00:00:00

requires mod=Mortis.BX
requires dlc=Biotech
requires dlc=Royalty
requires mod=VanillaExpanded.VPsycastsE

spawn Thing:FabricationBench name="Bench" faction=player
research Fabrication done=true
research VPE_CasterGear done=false
workbill "Bench" recipe=Make_BX_LifeVanquisher count=1 expect=refused
research VPE_CasterGear done=true
workbill "Bench" recipe=Make_BX_LifeVanquisher count=1
assert log clean

requires verb=vefability
requires assert=vefability
spawn Pawn:Colonist at 0,0 name="Reacher" xenotype=BX_Bernael
spawn Pawn:Colonist at 2,0 name="Plain"
vefability "Reacher" grant=VPE_Flameball
vefability "Plain" grant=VPE_Flameball
assert pawn "Reacher" gene=BX_PsychicReach expect=present
assert vefability "Plain" range ability=VPE_Flameball min=18.8 max=19.0
assert vefability "Reacher" range ability=VPE_Flameball min=23.5 max=23.75
assert log clean
