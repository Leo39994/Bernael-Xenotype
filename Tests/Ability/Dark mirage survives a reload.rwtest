rwtest 1
test "Dark mirage survives a reload" project="Bernael" created=2026-09-21T00:00:00

requires dlc=Biotech
requires dlc=Royalty

spawn Pawn:Colonist at 0,0 name="Bernael" xenotype=BX_Bernael
ability "Bernael" grant=BX_DarkMirage psylink=2 psyfocus=1.0
draft "Bernael"
select "Bernael"
gizmo "Dark mirage" expect=allowed
target cell=4,0 expect=allowed
waitfor thing BX_DarkMirageDecoy at 4,0 ticks=120 expect=present
assert thing BX_DarkMirageDecoy at 4,0 expect=present
assert inspect BX_DarkMirageDecoy contains "Caster: Bernael" expect=present

reload note="the decoy scribes its caster, its created tick and its expiry"

assert thing BX_DarkMirageDecoy at 4,0 expect=present
assert inspect BX_DarkMirageDecoy contains "Caster: Bernael" expect=present

tick 500 note="about 500 of the 600 ticks spent, counted from before the reload"
assert thing BX_DarkMirageDecoy at 4,0 expect=present

tick 180 note="about 680 ticks, past the 600 of durationTicks"
assert thing BX_DarkMirageDecoy expect=absent

undraft "Bernael"
assert log clean
