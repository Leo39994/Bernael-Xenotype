rwtest 1
test "Dire orb strikes only the standing hostiles in its blast" project="Bernael" created=2026-10-06T00:00:00

requires dlc=Biotech
requires dlc=Royalty

speed paused
spawn Pawn:Colonist at 0,0 name="Bernael" xenotype=BX_Bernael
ability "Bernael" grant=BX_DireOrb psylink=3 psyfocus=1.0
spawn Pawn:Pirate at 9,1 name="Near" faction=enemy
pacify "Near"
spawn Pawn:Pirate at 8,7 name="Far" faction=enemy
pacify "Far"
spawn Pawn:Pirate at 7,2 name="Downed" faction=enemy
down "Downed"
spawn Pawn:Colonist at 7,-1 name="Ally"
draft "Ally"

assert pawn "Near" pain max=0 expect=present

draft "Bernael"
select "Bernael"
gizmo "Dire orb" expect=allowed
target cell=8,0 expect=allowed
speed x1

waitfor casts "Bernael" ability=BX_DireOrb min=1 ticks=150
waitfor hit "Near" by="Bernael" min=1 ticks=300
assert hit "Near" by="Bernael" min=1 max=1
assert pawn "Near" pain min=0.01 expect=present
assert casts "Bernael" ability=BX_DireOrb min=1 max=1
assert hit "Far" by="Bernael" max=0
assert hit "Downed" by="Bernael" max=0
assert hit "Ally" by="Bernael" max=0
gizmo "Dire orb" expect=disabled

undraft "Bernael"
undraft "Ally"
assert log clean
