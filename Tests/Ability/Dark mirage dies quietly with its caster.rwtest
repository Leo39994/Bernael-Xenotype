rwtest 1
test "Dark mirage dies quietly with its caster" project="Bernael" created=2026-09-21T00:00:00

requires dlc=Biotech
requires dlc=Royalty

spawn Pawn:Colonist at 0,0 name="Owner" xenotype=BX_Bernael
spawn Pawn:Colonist at 1,0 name="Keeper"
ability "Owner" grant=BX_DarkMirage psylink=2 psyfocus=1.0
ability "Keeper" grant=BX_DarkMirage psylink=2 psyfocus=1.0
draft "Owner"
draft "Keeper"

select "Owner"
gizmo "Dark mirage" expect=allowed
target cell=4,0 expect=allowed
waitfor thing BX_DarkMirageDecoy at 4,0 ticks=120 expect=present
select "Keeper"
gizmo "Dark mirage" expect=allowed
target cell=10,0 expect=allowed
waitfor thing BX_DarkMirageDecoy at 10,0 ticks=120 expect=present
assert thing BX_DarkMirageDecoy at 4,0 expect=present
assert thing BX_DarkMirageDecoy at 10,0 expect=present

speed paused
spawn Pawn:Pirate at 5,0 name="Beside Owner" faction=enemy
spawn Pawn:Pirate at 11,0 name="Beside Keeper" faction=enemy
pacify "Beside Owner"
pacify "Beside Keeper"

damage "Owner" amount=999
tick 10 note="TickInterval reads the caster every tick"

assert thing BX_DarkMirageDecoy at 4,0 expect=absent
assert pawn "Beside Owner" hediff=Frostbite expect=absent

assert thing BX_DarkMirageDecoy at 10,0 expect=present
despawn Thing:BX_DarkMirageDecoy
assert pawn "Beside Keeper" hediff=Frostbite expect=present

undraft "Keeper"
assert log clean
