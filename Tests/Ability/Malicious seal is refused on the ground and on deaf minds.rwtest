rwtest 1
test "Malicious seal is refused on the ground and on deaf minds" project="Bernael" created=2026-10-09T00:00:00

requires dlc=Biotech
requires dlc=Royalty

spawn Pawn:Colonist at 0,0 name="Bernael" xenotype=BX_Bernael
ability "Bernael" grant=BX_MaliciousSeal psylink=3 psyfocus=1.0
spawn Pawn:Pirate at 6,0 name="Deaf" faction=enemy
give "Deaf" trait=PsychicSensitivity:-2
down "Deaf"
spawn Pawn:Pirate at 6,2 name="Target" faction=enemy
down "Target"
draft "Bernael"
select "Bernael"

assert pawn "Deaf" stat=PsychicSensitivity max=0 expect=present

gizmo "Malicious seal" expect=allowed
target cell=4,0 expect=refused
gizmo "Malicious seal" expect=allowed
target "Deaf" expect=refused
tick 150 note="1.2 s warmup is 72 ticks, plus the job that carries it, in case either cast went through anyway"
assert casts "Bernael" ability=BX_MaliciousSeal max=0
assert pawn "Deaf" hediff=BX_MaliciousSeal expect=absent

gizmo "Malicious seal" expect=allowed
target "Target" expect=allowed
waitfor pawn "Target" hediff=BX_MaliciousSeal ticks=400 expect=present
assert casts "Bernael" ability=BX_MaliciousSeal min=1 max=1

undraft "Bernael"
assert log clean
