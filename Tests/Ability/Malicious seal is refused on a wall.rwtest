rwtest 1
test "Malicious seal is refused on a wall" project="Bernael" created=2026-10-06T00:00:00

requires dlc=Biotech
requires dlc=Royalty

spawn Thing:Wall at 6,0
spawn Pawn:Colonist at 0,0 name="Bernael" xenotype=BX_Bernael
ability "Bernael" grant=BX_MaliciousSeal psylink=3 psyfocus=1.0
draft "Bernael"
select "Bernael"

gizmo "Malicious seal" expect=allowed
target cell=6,0 expect=refused reason="Malicious seal needs a walkable cell."

gizmo "Malicious seal" expect=allowed
target cell=4,0 expect=allowed
tick 150 note="1.2 s warmup is 72 ticks, plus the job that carries it"
assert casts "Bernael" ability=BX_MaliciousSeal min=1 max=1

undraft "Bernael"
assert log clean
